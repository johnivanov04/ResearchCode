{
  "task": "serial-dilution",
  "note": "Illustrative examples from the task statement. Values are exact unless stated; compare floats with a relative tolerance of about 1e-9.",
  "examples": [
    {
      "call": "convert_volume(250, \"uL\", \"mL\")",
      "expected": 0.25
    },
    {
      "call": "step_dilution_factor(100, \"uL\", 900, \"uL\")",
      "expected": 10.0
    },
    {
      "call": "cumulative_dilution_factors([{\"transfer_volume\": 1, \"transfer_unit\": \"mL\", \"diluent_volume\": 9, \"diluent_unit\": \"mL\"}, {\"transfer_volume\": 1, \"transfer_unit\": \"mL\", \"diluent_volume\": 9, \"diluent_unit\": \"mL\"}])",
      "expected": [10.0, 100.0]
    },
    {
      "call": "estimate_cfu_per_ml([{\"colonies\": 150, \"dilution_factor\": 10000, \"plated_volume\": 0.1, \"plated_unit\": \"mL\"}])",
      "expected": { "cfu_per_ml": 15000000.0, "status": "ok", "plates_used": 1 }
    },
    {
      "call": "estimate_cfu_per_ml([{\"colonies\": 12, \"dilution_factor\": 100, \"plated_volume\": 0.1, \"plated_unit\": \"mL\"}])",
      "expected": { "cfu_per_ml": null, "status": "no_countable_plates", "plates_used": 0 }
    },
    {
      "call": "dilution_volumes(2.0, 0.5, 8, \"mL\")",
      "expected": { "stock_volume": 2.0, "diluent_volume": 6.0 }
    },
    {
      "call": "step_dilution_factor(0, \"uL\", 900, \"uL\")",
      "expected": "raises ValueError"
    }
  ]
}
