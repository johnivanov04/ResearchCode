# Python environment and caches (recreate with `uv sync`)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.hypothesis/

# Build output (`uv build`)
dist/
build/
*.egg-info/

# Trial workspaces belong outside the repository; never commit them here.
trials/
# Dry runs and other fixture output must never be committed.
dry-run*/

# Secrets: never commit these
.env
.env.*
*.pem
*.key

.DS_Store

# The genuine evaluator is private and lives OUTSIDE this repository (see src/rc_experiments/evaluators.py).
# These patterns stop an accidental copy from being committed.
rc_private_evaluator/
private-evaluator/
**/hidden/
